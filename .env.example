# Local browser port. Application has no production authentication yet.
STUDIO_PORT=4180
# auto | gigaam | mock — mock used in CI without GPU
TRANSCRIBE_BACKEND=auto

# --- Billing (local file-backed ledger; default off for holds) ---
# When false: jobs still store cost snapshot; holds/debit skipped.
BILLING_ENABLED=false
# Directory for ledger.json (users, wallets, holds, promos). Default: .local-billing/
# BILLING_ROOT=

# --- Payments: stub | yookassa | yoomoney (no real charges without secrets) ---
PAYMENT_DRIVER=stub

# YooKassa (ЮKassa) — acquiring shop (SPEC PaymentProvider candidate)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_RETURN_URL=http://127.0.0.1:4180/?payment=ok
# Webhook path: POST /api/webhooks/yookassa  (needs public HTTPS in production)

# YooMoney (ЮMoney) — wallet API (often confused with YooKassa as «Юмани»)
# YOOMONEY_ACCOUNT=
# YOOMONEY_OAUTH_TOKEN=
# YOOMONEY_NOTIFICATION_SECRET=
# YOOMONEY_RETURN_URL=http://127.0.0.1:4180/?payment=ok
# Webhook path: POST /api/webhooks/yoomoney
